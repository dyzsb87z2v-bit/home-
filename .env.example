# ---- Core ----
APP_ENV=development                 # development | testing | production
APP_URL=http://localhost:3000
DATABASE_URL=postgres://brh:brh@localhost:5432/berlin_rent_hunter
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# 32 random bytes, base64 — encrypts OAuth tokens and uploaded documents at rest
APP_ENCRYPTION_KEY=

# ---- Anthropic Claude (optional; deterministic fallbacks are used when unset) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Monthly AI spend cap in EUR-cents equivalent (USD cents); AI calls stop when reached
AI_MONTHLY_BUDGET_CENTS=2000

# ---- Gmail OAuth (create an OAuth client in Google Cloud Console, type "Web application") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in the Google OAuth client: ${APP_URL}/api/email/google/callback

# ---- Web Push (generate with: npx web-push generate-vapid-keys) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Maps (optional; defaults to OpenStreetMap raster tiles with attribution) ----
NEXT_PUBLIC_MAP_STYLE_URL=

# ---- Outbound fetching for permitted feeds ----
FETCH_USER_AGENT=BerlinRentHunterAI/0.1 (+contact: you@example.com)
